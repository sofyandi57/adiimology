# Salin menjadi .streamlit/secrets.toml (jangan di-commit) atau isi di Streamlit Cloud > Settings > Secrets
INVEZGO_API_KEY = "isi-api-key-invezgo-anda"
APP_LOGIN_EMAIL = "email-anda@contoh.com"
APP_LOGIN_PASSWORD = "ganti-dengan-password-kuat"

# Database histori (Neon Postgres). Tanpa ini histori hanya tersimpan per sesi.
[connections.histori]
url = "postgresql://user:password@host/dbname?sslmode=require"
